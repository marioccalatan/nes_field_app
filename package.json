{
  "name": "nes-field-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:usb": "set EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000&& expo start --host localhost --clear",
    "android:usb": "set EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000&& expo start --android --host localhost --clear"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.39",
    "expo-image-picker": "~15.1.0",
    "expo-location": "~17.0.1",
    "expo-sqlite": "~14.0.6",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-maps": "1.14.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0"
  }
}
